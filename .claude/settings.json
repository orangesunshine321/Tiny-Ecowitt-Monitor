      "Read(//**/etc/pve1-dash/ssh/id_ed25519)",
      "Read(//**/var/lib/pve1-dash/push.json)",
      "Edit(//etc/pve/**)",
      "Edit(//root/.ssh/**)",
      "Edit(//etc/ssh/**)",
