{
  "name": "pve1-dash",
  "version": "0.1.0",
  "description": "A read-only, Liquid Glass styled homelab dashboard for a Proxmox VE node.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "PVE1_DASH_DEMO=1 tsx watch server/index.ts & vite; wait",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "demo": "PVE1_DASH_DEMO=1 tsx server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "ssh2": "^1.17.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
