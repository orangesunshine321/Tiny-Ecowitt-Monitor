#!/bin/bash
# pve1-dash-helper: read-only forced-command helper for pve1-dash on the Proxmox VE host (helper protocol v2,
# docs/HELPER_PROTOCOL.md). Works on PVE 8.x and 9.x.
#
# Install at /usr/local/sbin/pve1-dash-helper (root:root, 0755) and authorize the dashboard key in
# /root/.ssh/authorized_keys (a symlink to /etc/pve/priv/authorized_keys on PVE) pinned to this script:
#   restrict,command="/usr/local/sbin/pve1-dash-helper" ssh-ed25519 AAAA... pve1-dash
#
# sshd ignores the command the client asked for and passes it here as SSH_ORIGINAL_COMMAND. It is matched against a
# strict allow-list and is never evaluated or handed to a shell:
#   version              -> "pve1-dash-helper 2"
#   inventory [vmid] [quick]
#                        -> framed inventory of running LXCs (pct exec) and running agent-enabled VMs (qm guest exec);
#                           "quick" skips counting package updates inside the guests (the one slow probe)
#   sensors              -> raw `sensors -j` JSON (exit 3 when lm-sensors is not installed)
#   pkgupdates           -> pending package updates as a JSON array (the /var/lib/pve-manager/pkgupdates objects),
#                           recomputed from the local apt cache when that file is stale, without already installed ones
#   hostinfo             -> "key value" lines: running kernel, installed kernels, boot pins, package list timestamps
#   backups <storage>    -> backup volumes of a storage as JSON (pvesh as root; the API hides them from PVEAuditor)
# Anything else prints "denied" on stderr and exits 1. With no command, "inventory" runs.
# Root can also run it by hand for testing: pve1-dash-helper inventory 101
set -u
umask 077
export LC_ALL=C
# Append the standard locations: sshd's PATH for root normally has them, but be explicit.
export PATH="${PATH:+$PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

readonly PROTOCOL=2
readonly GUEST_TIMEOUT=25        # seconds per guest (pct exec; qm guest exec --timeout)
readonly QM_TIMEOUT=30           # outer bound for `qm guest exec` (its own --timeout is GUEST_TIMEOUT)
readonly KILL_AFTER=5            # SIGKILL this long after timeout's SIGTERM
readonly MAX_PARALLEL=4          # guests inspected at the same time
readonly MAX_GUEST_BYTES=1048576 # per-guest output cap
readonly PKGUPDATES_FILE=/var/lib/pve-manager/pkgupdates
readonly DPKG_STATUS=/var/lib/dpkg/status
readonly APT_PKGCACHE=/var/cache/apt/pkgcache.bin
readonly APT_LISTS=/var/lib/apt/lists
readonly BOOT_DIR=/boot
readonly KERNEL_PIN=/etc/kernel/proxmox-boot-pin
readonly KERNEL_NEXT_PIN=/etc/kernel/next-boot-pin
# Host-only list of guests that are never entered (one vmid per line, # starts a comment). For guests whose agent
# should not run the inventory every sweep, e.g. a VM whose qemu-guest-agent has wedged on large output. The
# container can't change it; a missing file skips nothing.
readonly SKIP_FILE=/etc/pve1-dash-helper.skip

# The command line comes from sshd (forced command) or, for manual runs, from the arguments.
CMDLINE=${SSH_ORIGINAL_COMMAND:-$*}
# Containers are entered with `pct exec --keep-env 0` (a clean environment); dropping the SSH session variables here
# as well is defense in depth, e.g. for anything this script starts on the host.
unset SSH_ORIGINAL_COMMAND SSH_CLIENT SSH_CONNECTION SSH_TTY SSH_AUTH_SOCK

# The inner guest script, run inside each guest. Identical to the body of pve1-dash-guest-inventory and to
# server/inventory/innerScript.ts (tests/inventory-scripts.test.ts enforces this).
IFS= read -r -d '' INNER <<'PVE1_DASH_INNER' || :
# >>> pve1-dash inner v2 >>>
# Inventory of this guest for pve1-dash (helper protocol v2). Read-only and POSIX sh, so it runs under dash, bash and
# busybox. Every section is optional: a missing tool leaves its section empty. This exact text is also embedded in
# pve1-dash-helper (run via pct exec / qm guest exec) and in server/inventory/innerScript.ts; keep all three identical.
# The last two PATH entries are NixOS's: its tools are not in the FHS directories, and `pct exec --keep-env 0` does
# not pass on the guest's own PATH.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin
LC_ALL=C
export PATH LC_ALL
# Bound every probe so a hung daemon (docker, systemd, ...) cannot stall the whole inventory.
p1d_t=''
if command -v timeout >/dev/null 2>&1 && timeout 5 true >/dev/null 2>&1; then p1d_t='timeout 15'; fi
p1d_has() { command -v "$1" >/dev/null 2>&1; }
p1d_sec() { printf '##pve1-dash:section %s\n' "$1"; }
# Print text followed by exactly one newline; print nothing for empty text.
p1d_put() { if [ -n "$1" ]; then printf '%s\n' "$1"; fi; }
# Run a probe (stderr dropped) and print its stdout.
# shellcheck disable=SC2086 # $p1d_t is intentionally split into "timeout 15"
p1d_run() { p1d_o=$($p1d_t "$@" 2>/dev/null) || :; p1d_put "$p1d_o"; }
# Number of lines of text $1 that match the basic regex $2.
p1d_count() { printf '%s\n' "$1" | grep -c -- "$2"; }
# "stamp <epoch seconds>" with the modification time of a file or directory, nothing when it does not exist.
p1d_stamp() {
  if [ -e "$1" ]; then
    p1d_s=$(stat -c %Y "$1" 2>/dev/null) || p1d_s=$(date -r "$1" +%s 2>/dev/null) || p1d_s=''
    if [ -n "$p1d_s" ]; then printf 'stamp %s\n' "$p1d_s"; fi
  fi
}

# First argument "quick": skip counting package updates, the one slow probe (the dashboard asks for it hourly).
p1d_quick=''
if [ "${1:-}" = quick ]; then p1d_quick=1; fi

printf '##pve1-dash:inventory v2\n'

p1d_sec os-release
for p1d_f in /etc/os-release /usr/lib/os-release; do
  if [ -r "$p1d_f" ]; then
    p1d_put "$(cat "$p1d_f" 2>/dev/null)"
    break
  fi
done

p1d_sec kernel
p1d_run uname -r

p1d_sec uptime
p1d_put "$(cat /proc/uptime 2>/dev/null)"

p1d_sec loadavg
p1d_put "$(cat /proc/loadavg 2>/dev/null)"

p1d_sec init
if [ -d /run/systemd/system ]; then
  p1d_init=systemd
elif [ -d /run/openrc ] || p1d_has openrc-run || p1d_has rc-status; then
  p1d_init=openrc
else
  p1d_init=unknown
fi
printf '%s\n' "$p1d_init"

p1d_sec services
case $p1d_init in
  systemd)
    p1d_run systemctl list-units --type=service --state=running --no-legend --no-pager --plain
    ;;
  openrc)
    # shellcheck disable=SC2086
    p1d_o=$($p1d_t rc-status --servicelist 2>/dev/null) || p1d_o=''
    # shellcheck disable=SC2086
    [ -n "$p1d_o" ] || p1d_o=$($p1d_t rc-status -s 2>/dev/null) || p1d_o=''
    p1d_put "$p1d_o"
    ;;
esac

p1d_sec docker
if p1d_has docker; then
  echo present
  p1d_run docker ps -a --no-trunc --format '{{json .}}'
else
  echo absent
fi

p1d_sec ip
p1d_o=''
# shellcheck disable=SC2086
if p1d_has ip; then p1d_o=$($p1d_t ip -o addr show 2>/dev/null) || p1d_o=''; fi
# shellcheck disable=SC2086
if [ -z "$p1d_o" ] && p1d_has ifconfig; then p1d_o=$($p1d_t ifconfig 2>/dev/null) || p1d_o=''; fi
p1d_put "$p1d_o"

p1d_sec listen
p1d_o=''
if p1d_has ss; then
  # shellcheck disable=SC2086
  p1d_o=$($p1d_t ss -Hltnp 2>/dev/null) || p1d_o=''
  # old iproute2 has no -H; the parser skips the header line
  # shellcheck disable=SC2086
  [ -n "$p1d_o" ] || p1d_o=$($p1d_t ss -ltnp 2>/dev/null) || p1d_o=''
fi
if [ -z "$p1d_o" ] && p1d_has netstat; then
  # shellcheck disable=SC2086
  p1d_o=$($p1d_t netstat -ltnp 2>/dev/null) || p1d_o=''
  # some busybox builds have no -p
  # shellcheck disable=SC2086
  [ -n "$p1d_o" ] || p1d_o=$($p1d_t netstat -ltn 2>/dev/null) || p1d_o=''
fi
p1d_put "$p1d_o"

p1d_sec df
# Mounted filesystems in 1K blocks; the dashboard drops pseudo filesystems. -l (local only, so a hung network mount
# cannot stall df) is GNU-only and very old busybox has no -T, hence the fallbacks. df exits 1 when one mount cannot
# be read but still lists the others, so any output counts; a timeout ends the attempts.
p1d_o=''
if p1d_has df; then
  for p1d_a in '-P -T -k -l' '-P -T -k' '-P -k'; do
    # shellcheck disable=SC2086
    p1d_o=$($p1d_t df $p1d_a 2>/dev/null)
    p1d_rc=$?
    if [ -n "$p1d_o" ] || [ "$p1d_rc" -ge 124 ]; then break; fi
  done
fi
p1d_put "$p1d_o"

p1d_sec updates
# Pending package updates, from the local package cache only: nothing here refreshes it or uses the network.
# "manager <name>", "count <n>", "security <n>" where cheap, and "stamp <epoch>" for the files whose modification time
# tells when the package lists were last refreshed (the dashboard takes the newest). "skipped" in quick mode.
if [ -n "$p1d_quick" ]; then
  echo 'skipped'
elif p1d_has apt-get; then
  # dist-upgrade also counts what needs new packages (kernels); only upgrades of installed packages are counted:
  # "Inst <package> [<installed version>] (<new version> <origin> [<arch>])". NoLocking: works while apt runs.
  # shellcheck disable=SC2086
  if p1d_o=$($p1d_t apt-get -s -o Debug::NoLocking=1 dist-upgrade 2>/dev/null); then
    p1d_o=$(printf '%s\n' "$p1d_o" | grep '^Inst [^ ]* \[')
    echo 'manager apt'
    printf 'count %s\n' "$(p1d_count "$p1d_o" '^Inst ')"
    printf 'security %s\n' "$(p1d_count "$p1d_o" '[Ss]ecurity')"
    for p1d_f in /var/lib/apt/lists /var/lib/apt/lists/partial /var/lib/apt/periodic/update-success-stamp; do
      p1d_stamp "$p1d_f"
    done
  fi
elif p1d_has apk; then
  # shellcheck disable=SC2086
  if p1d_o=$($p1d_t apk --no-network version -l '<' 2>/dev/null); then
    echo 'manager apk'
    printf 'count %s\n' "$(p1d_count "$p1d_o" ' < ')"
    for p1d_f in /var/cache/apk/APKINDEX.*; do p1d_stamp "$p1d_f"; done
  fi
elif p1d_has dnf || p1d_has yum; then
  if p1d_has dnf; then p1d_m=dnf; else p1d_m=yum; fi
  # -C: cache only. Exit 100 means updates are available. Package lines start with "<name>.<arch>" (a long name wraps
  # and its version starts the next line with blanks); the obsoletes list at the end is not counted.
  # shellcheck disable=SC2086
  p1d_o=$($p1d_t "$p1d_m" -C -q check-update 2>/dev/null)
  p1d_rc=$?
  if [ "$p1d_rc" -eq 0 ] || [ "$p1d_rc" -eq 100 ]; then
    p1d_o=$(printf '%s\n' "$p1d_o" | sed -n '/^Obsoleting/q;p')
    echo "manager $p1d_m"
    printf 'count %s\n' "$(p1d_count "$p1d_o" '^[^ ][^ ]*\.[^ ]')"
    for p1d_f in /var/cache/dnf/*/repodata/repomd.xml /var/cache/yum/*/*/*/repomd.xml; do p1d_stamp "$p1d_f"; done
  fi
elif p1d_has pacman; then
  # -Qu compares with the local sync databases (checkupdates would download new ones). Exit 1: nothing to update.
  # shellcheck disable=SC2086
  p1d_o=$($p1d_t pacman -Qu 2>/dev/null)
  p1d_rc=$?
  if [ "$p1d_rc" -le 1 ]; then
    p1d_o=$(printf '%s\n' "$p1d_o" | grep -v '\[ignored\]')
    echo 'manager pacman'
    printf 'count %s\n' "$(p1d_count "$p1d_o" ' -> ')"
    for p1d_f in /var/lib/pacman/sync/*.db; do p1d_stamp "$p1d_f"; done
  fi
fi

p1d_sec reboot
# "flag <source>" when the system says it needs a reboot: Debian/Ubuntu's reboot-required file, NixOS booted vs
# current kernel, `needs-restarting -r` (RHEL family; exit 1 = reboot needed). Outside containers also the installed
# kernels ("vmlinuz <version>"; the dashboard compares them with the running one) and "modules-missing" when the
# running kernel's modules are gone (Alpine and Arch remove them on upgrade). Containers share the host's kernel.
if [ -e /run/reboot-required ] || [ -e /var/run/reboot-required ]; then echo 'flag reboot-required'; fi
if [ -e /run/booted-system/kernel ] && [ -e /run/current-system/kernel ] &&
  [ "$(readlink -f /run/booted-system/kernel)" != "$(readlink -f /run/current-system/kernel)" ]; then
  echo 'flag nixos'
fi
if p1d_has needs-restarting; then
  # shellcheck disable=SC2086
  $p1d_t needs-restarting -r >/dev/null 2>&1
  p1d_rc=$?
  if [ "$p1d_rc" -eq 1 ]; then echo 'flag needs-restarting'; fi
fi
p1d_ct=''
if [ -n "${container:-}" ] || [ -e /run/.containerenv ] || [ -e /.dockerenv ]; then p1d_ct=1; fi
if [ -z "$p1d_ct" ] && { tr '\000' '\n' </proc/1/environ; } 2>/dev/null | grep -q '^container='; then
  p1d_ct=1
fi
if [ -n "$p1d_ct" ]; then
  echo 'container'
else
  p1d_k=$(uname -r 2>/dev/null) || p1d_k=''
  if [ -n "$p1d_k" ] && [ ! -d "/lib/modules/$p1d_k" ]; then
    for p1d_f in /lib/modules/*; do
      if [ -d "$p1d_f" ]; then
        echo 'modules-missing'
        break
      fi
    done
  fi
  for p1d_f in /boot/vmlinuz-*; do
    if [ -e "$p1d_f" ]; then printf 'vmlinuz %s\n' "${p1d_f#/boot/vmlinuz-}"; fi
  done
fi

printf '##pve1-dash:end\n'
exit 0
# <<< pve1-dash inner v2 <<<
PVE1_DASH_INNER
readonly INNER

# Perl is always present on PVE (the whole stack is Perl) and JSON::PP is a core module. Prints "<vmid> <kind> <status>"
# per guest from `pvesh get /nodes/<node>/{lxc,qemu} --output-format json`, skipping templates. For VMs the status is
# the QMP run state (`qmpstatus`, listed with --full 1), as `qm list` prints it: `status` alone says "running" for a
# paused, suspended, prelaunch or io-error VM, whose guest agent cannot answer.
# shellcheck disable=SC2016 # Perl code, not shell
readonly PERL_LIST_GUESTS='
use strict; use warnings; use JSON::PP;
my $kind = shift @ARGV;
my $data = eval { JSON::PP->new->decode(do { local $/; <STDIN> }) };
exit 1 unless ref($data) eq "ARRAY";
for my $g (@$data) {
  next unless ref($g) eq "HASH";
  next if $g->{template};
  my $id = $g->{vmid};
  next unless defined($id) && $id =~ /^[0-9]{1,9}$/;
  my $status = defined($g->{qmpstatus}) && $g->{qmpstatus} ne "" ? $g->{qmpstatus}
    : defined($g->{status}) ? $g->{status} : "unknown";
  $status =~ s/[^A-Za-z0-9_-]//g;
  print "$id $kind $status\n";
}'

# Reads "<package> <installed version>" lines, a "@@json" line, then a pkgupdates JSON array, and prints the array
# without the entries whose candidate `Version` is already installed.
# shellcheck disable=SC2016 # Perl code, not shell
readonly PERL_FILTER_UPDATES='
use strict; use warnings; use JSON::PP;
my %inst;
while (my $l = <STDIN>) {
  chomp $l;
  last if $l eq "\@\@json";
  my ($p, $v) = split / /, $l, 2;
  $inst{$p} = $v if defined($v) && $v ne "";
}
my $data = eval { JSON::PP->new->decode(do { local $/; <STDIN> }) };
exit 1 unless ref($data) eq "ARRAY";
my @keep = grep {
  !(ref($_) eq "HASH" && defined($_->{Package}) && defined($_->{Version}) && !ref($_->{Package})
    && defined($inst{$_->{Package}}) && $inst{$_->{Package}} eq $_->{Version})
} @$data;
print JSON::PP->new->canonical->encode(\@keep), "\n";'

deny() {
  if command -v logger >/dev/null 2>&1; then
    logger -t pve1-dash-helper -p auth.notice -- "denied command: ${CMDLINE//[^A-Za-z0-9._ -]/?}" 2>/dev/null || :
  fi
  echo 'denied' >&2
  exit 1
}

# Node name as Proxmox sees it (PVE uses the short hostname).
node_name() {
  local n
  n=$(hostname 2>/dev/null) || n=''
  n=${n%%.*}
  if [[ ! $n =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,62})$ ]]; then
    echo 'cannot determine the node name' >&2
    exit 2
  fi
  printf '%s' "$n"
}

# Write "<vmid> <lxc|qemu> <status>" lines for the guests on this node to <dest>, templates excluded, sorted by vmid.
# Returns 1 when a guest type could not be listed at all.
# Prefer pvesh JSON: `pct list` has an often-empty Lock column and `qm list` NAME defaults to "VM <vmid>" (a space),
# so whitespace splitting of the text tables is ambiguous. The text tables are only a fallback (pvesh broken, etc.):
# their first columns are unambiguous, and qm list's STATUS is read counting from the end.
list_guests() { # <node> <dest file>
  local node=$1 dest=$2 kind json out failed=0
  local -a full=()
  : >"$dest.unsorted"
  for kind in lxc qemu; do
    # --full 1 adds qmpstatus (one QMP query-status per running VM, as `qm list` does); lxc has no such option.
    full=()
    if [[ $kind == qemu ]]; then full=(--full 1); fi
    if json=$(timeout -k "$KILL_AFTER" 30 pvesh get "/nodes/$node/$kind" "${full[@]}" --output-format json 2>/dev/null) &&
      out=$(perl -e "$PERL_LIST_GUESTS" "$kind" <<<"$json" 2>/dev/null); then
      if [[ -n $out ]]; then printf '%s\n' "$out" >>"$dest.unsorted"; fi
      continue
    fi
    if [[ $kind == lxc ]]; then
      out=$(timeout -k "$KILL_AFTER" 30 pct list 2>/dev/null)
    else
      out=$(timeout -k "$KILL_AFTER" 30 qm list 2>/dev/null)
    fi || {
      failed=1
      continue
    }
    if [[ $kind == lxc ]]; then
      awk 'NR > 1 && $1 ~ /^[0-9]+$/ && NF >= 2 { print $1, "lxc", $2 }' <<<"$out" >>"$dest.unsorted"
    else
      awk 'NR > 1 && $1 ~ /^[0-9]+$/ && NF >= 6 { print $1, "qemu", $(NF - 3) }' <<<"$out" >>"$dest.unsorted"
    fi
  done
  sort -n -k1,1 "$dest.unsorted" >"$dest"
  return "$failed"
}

# `agent: 1`, `agent: enabled=1,...`, `agent: 1,type=virtio` are enabled; `agent: 0` or no line is disabled.
# The bare first value of the property string is `enabled` (qemu-server $agent_fmt default_key).
agent_enabled() {
  local line value part
  local -a parts=()
  line=$(grep -m 1 -E '^agent:' <<<"$1") || return 1
  value=${line#agent:}
  value=${value//[[:space:]]/}
  IFS=, read -r -a parts <<<"$value"
  for part in "${parts[@]}"; do
    case $part in
      enabled=*) part=${part#enabled=} ;;
      *=*) continue ;;
    esac
    [[ ${part,,} =~ ^(1|on|yes|true)$ ]]
    return
  done
  return 1
}

is_windows() {
  grep -qE '^ostype:[[:space:]]*(win|w2k|wxp|wvista)' <<<"$1"
}

# One printable line describing why a guest could not be inspected.
error_text() { # <exit code> <stderr file> <timeout seconds>
  local rc=$1 errfile=$2 limit=$3 msg=''
  if ((rc == 124 || rc == 137)); then
    printf 'timeout after %ss' "$limit"
    return
  fi
  if [[ -s $errfile ]]; then
    msg=$(tr -d '\r' <"$errfile" | grep -v '^[[:space:]]*$' | tail -n 1 | tr -cd '[:print:]' | cut -c 1-200)
  fi
  printf '%s' "${msg:-exit code $rc}"
}

# Inspect one guest and write its framed block to <base>.block (no file = guest skipped).
inspect_guest() { # <vmid> <lxc|qemu> <base path>
  local vmid=$1 type=$2 base=$3 transport limit rc cfg size
  local out=$base.out err=$base.err
  # Skipped guests write no block, like a VM without the agent ($vmid is digits only, checked by the caller).
  if [[ -r $SKIP_FILE ]] && grep -qE "^[[:space:]]*${vmid}[[:space:]]*(#.*)?$" "$SKIP_FILE"; then return 0; fi
  if [[ $type == lxc ]]; then
    transport=pct-exec
    limit=$GUEST_TIMEOUT
    # --keep-env 0: the CT gets a clean environment (only container=lxc), not root's host environment, which
    # includes whatever /root/.bashrc exports (pct exec defaults to --keep-env 1 on PVE 8 and 9). The inner script
    # sets its own PATH and LC_ALL, and /bin/sh is an absolute path.
    # The inner script gets $0 = pve1-dash-inner and, in quick mode, $1 = quick.
    timeout -k "$KILL_AFTER" "$GUEST_TIMEOUT" pct exec "$vmid" --keep-env 0 -- \
      /bin/sh -c "$INNER" pve1-dash-inner ${INNER_MODE:+"$INNER_MODE"} </dev/null 2>"$err" |
      head -c "$MAX_GUEST_BYTES" >"$out"
    rc=${PIPESTATUS[0]}
  else
    transport=qm-guest-exec
    limit=$QM_TIMEOUT
    cfg=$(timeout -k "$KILL_AFTER" 15 qm config "$vmid" --current 2>/dev/null) || return 0
    agent_enabled "$cfg" || return 0
    if is_windows "$cfg"; then
      printf '@@pve1-dash:guest %s %s %s\n@@pve1-dash:error unsupported OS (windows)\n@@pve1-dash:end %s 1\n' \
        "$vmid" "$type" "$transport" "$vmid" >"$base.block"
      return 0
    fi
    timeout -k "$KILL_AFTER" "$QM_TIMEOUT" qm guest exec "$vmid" --timeout "$GUEST_TIMEOUT" -- \
      /bin/sh -c "$INNER" pve1-dash-inner ${INNER_MODE:+"$INNER_MODE"} </dev/null 2>"$err" | head -c "$MAX_GUEST_BYTES" >"$out"
    rc=${PIPESTATUS[0]}
  fi
  size=$(wc -c <"$out")
  {
    printf '@@pve1-dash:guest %s %s %s\n' "$vmid" "$type" "$transport"
    if ((size >= MAX_GUEST_BYTES)); then
      printf '@@pve1-dash:error output exceeded %s bytes\n' "$MAX_GUEST_BYTES"
    elif ((rc != 0)) && grep -q '^##pve1-dash:inventory ' "$out"; then
      # The inner script started but did not finish (e.g. a slow probe ran into the time limit): pass on what it
      # printed, then say why it stopped. Only pct exec streams like this; qm guest exec prints nothing on a timeout.
      sed 's/^@@/ @@/' "$out"
      [[ -z $(tail -c 1 "$out") ]] || echo
      printf '@@pve1-dash:error %s\n' "$(error_text "$rc" "$err" "$limit")"
    elif ((rc != 0)); then
      printf '@@pve1-dash:error %s\n' "$(error_text "$rc" "$err" "$limit")"
    elif ((size == 0)); then
      printf '@@pve1-dash:error no output\n'
    else
      # A guest must not be able to forge framing lines for other guests.
      sed 's/^@@/ @@/' "$out"
      [[ -z $(tail -c 1 "$out") ]] || echo
    fi
    printf '@@pve1-dash:end %s %s\n' "$vmid" "$rc"
  } >"$base.block"
}

# Print the blocks of finished guests, in vmid order, up to the first guest that is still running. Streaming them
# (instead of printing everything at the end) means a client that gives up early still gets the finished guests.
FLUSHED=0
flush_blocks() {
  local vmid
  while ((FLUSHED < ${#ORDER[@]})); do
    vmid=${ORDER[FLUSHED]}
    [[ -e $TMPD/$vmid.done ]] || return 0
    if [[ -s $TMPD/$vmid.block ]]; then cat -- "$TMPD/$vmid.block"; fi
    FLUSHED=$((FLUSHED + 1))
  done
}

INNER_MODE=''
cmd_inventory() { # <vmid or ''> <'' | quick>
  local want=${1:-} node vmid kind status
  INNER_MODE=${2:-}
  local -a running=()
  ORDER=()
  # Header first: anything a noisy .bashrc printed before it is ignored by the dashboard.
  printf '@@pve1-dash:inventory v%s\n' "$PROTOCOL"
  node=$(node_name) || exit 2
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/pve1-dash.XXXXXXXX") || {
    echo 'mktemp failed' >&2
    exit 2
  }
  trap 'rm -rf -- "$TMPD"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 141' PIPE
  trap 'exit 143' TERM

  if ! list_guests "$node" "$TMPD/guests"; then
    # No "done" line: the dashboard treats this run as failed and keeps its previous data.
    echo "cannot list the guests of node $node (pvesh and pct/qm list failed)" >&2
    exit 2
  fi
  while read -r vmid kind status; do
    # only guests whose vCPUs run: a paused/suspended/prelaunch/io-error VM's agent cannot answer
    [[ $status == running ]] || continue
    if [[ -n $want ]] && ((10#$vmid != 10#$want)); then continue; fi
    # at most MAX_PARALLEL guests at a time
    while :; do
      mapfile -t running < <(jobs -rp)
      ((${#running[@]} < MAX_PARALLEL)) && break
      wait -n 2>/dev/null || :
      flush_blocks
    done
    # Workers write only to their files; stdout carries nothing but framed, in-order blocks.
    {
      inspect_guest "$vmid" "$kind" "$TMPD/$vmid"
      : >"$TMPD/$vmid.done"
    } </dev/null >/dev/null &
    ORDER+=("$vmid")
  done <"$TMPD/guests"
  while ((FLUSHED < ${#ORDER[@]})); do
    mapfile -t running < <(jobs -rp)
    if ((${#running[@]} == 0)); then
      wait
      flush_blocks
      # A worker that died without its marker (should not happen): skip that guest instead of waiting forever.
      if ((FLUSHED < ${#ORDER[@]})); then : >"$TMPD/${ORDER[FLUSHED]}.done"; fi
      continue
    fi
    wait -n 2>/dev/null || :
    flush_blocks
  done
  printf '@@pve1-dash:done\n'
}

cmd_sensors() {
  if ! command -v sensors >/dev/null 2>&1; then
    echo 'lm-sensors not installed' >&2
    exit 3
  fi
  timeout -k "$KILL_AFTER" 20 sensors -j
  exit $?
}

# Print a pkgupdates JSON array (stdin) without the packages whose candidate version is already installed; unchanged
# when dpkg-query or perl fail.
filter_installed() {
  local json installed filtered
  json=$(cat)
  # shellcheck disable=SC2016 # dpkg-query fields, not shell variables
  installed=$(timeout -k "$KILL_AFTER" 30 dpkg-query -W -f='${Status} ${Package} ${Version}\n' 2>/dev/null |
    awk '$3 == "installed" && NF == 5 { print $4, $5 }') || installed=''
  if [[ -n $installed ]] &&
    filtered=$(printf '%s\n@@json\n%s\n' "$installed" "$json" | perl -e "$PERL_FILTER_UPDATES" 2>/dev/null) &&
    [[ $filtered == '['* ]]; then
    printf '%s\n' "$filtered"
  else
    printf '%s\n' "$json"
  fi
}

cmd_pkgupdates() {
  local node json=''
  # The cache file is written by the daily `pveupdate` only after `apt-get update` worked for every repository (one
  # failing repository, e.g. the enterprise one without a subscription, leaves it stale or missing), and a manual
  # `apt full-upgrade` does not touch it. When it is missing or older than the package database or the apt cache,
  # recompute the list the way the web UI's Updates panel does: GET /nodes/<node>/apt/update as root reads the local
  # apt cache only (no download) and rewrites the file.
  if [[ ! -s $PKGUPDATES_FILE || $DPKG_STATUS -nt $PKGUPDATES_FILE || $APT_PKGCACHE -nt $PKGUPDATES_FILE ]]; then
    node=$(node_name) || exit 2
    json=$(timeout -k "$KILL_AFTER" 60 pvesh get "/nodes/$node/apt/update" --output-format json 2>/dev/null) || json=''
    [[ $json == '['* ]] || json=''
  fi
  if [[ -z $json && -s $PKGUPDATES_FILE ]]; then json=$(<"$PKGUPDATES_FILE"); fi
  filter_installed <<<"${json:-[]}"
}

# "<key> <value>" lines for the dashboard (helper protocol v2):
#   running <uname -r>                 vmlinuz <version>  (one per /boot/vmlinuz-*)
#   package <installed proxmox-kernel-* / pve-kernel-* package>
#   pin <version> / next-boot-pin <version>   (proxmox-boot-tool kernel pin; it boots instead of the newest kernel)
#   stamp-lists <epoch>  (apt package lists: when they were last refreshed)   stamp-pkgupdates <epoch>
cmd_hostinfo() {
  local f v re_ver='^[A-Za-z0-9._+~-]{1,100}$'
  v=$(uname -r 2>/dev/null) || v=''
  if [[ $v =~ $re_ver ]]; then printf 'running %s\n' "$v"; fi
  for f in "$BOOT_DIR"/vmlinuz-*; do
    v=${f##*/vmlinuz-}
    if [[ -e $f && $v =~ $re_ver ]]; then printf 'vmlinuz %s\n' "$v"; fi
  done
  # shellcheck disable=SC2016 # dpkg-query fields, not shell variables
  timeout -k "$KILL_AFTER" 30 dpkg-query -W -f='${Status} ${Package}\n' 'proxmox-kernel-*' 'pve-kernel-*' 2>/dev/null |
    awk '$3 == "installed" && NF == 4 { print "package", $4 }'
  for f in "$KERNEL_PIN:pin" "$KERNEL_NEXT_PIN:next-boot-pin"; do
    v=''
    if [[ -s ${f%:*} ]]; then v=$(head -n 1 -- "${f%:*}" 2>/dev/null | tr -d '[:space:]'); fi
    if [[ $v =~ $re_ver ]]; then printf '%s %s\n' "${f##*:}" "$v"; fi
  done
  for f in "$APT_LISTS" "$APT_LISTS/partial"; do
    if [[ -e $f ]] && v=$(stat -c %Y -- "$f" 2>/dev/null); then printf 'stamp-lists %s\n' "$v"; fi
  done
  if [[ -e $PKGUPDATES_FILE ]] && v=$(stat -c %Y -- "$PKGUPDATES_FILE" 2>/dev/null); then
    printf 'stamp-pkgupdates %s\n' "$v"
  fi
}

cmd_backups() { # <storage id, validated>
  local node
  node=$(node_name) || exit 2
  # PBS storages can take long to answer (PVE allows 120 s to connect); the dashboard waits slightly longer than this.
  timeout -k "$KILL_AFTER" 90 pvesh get "/nodes/$node/storage/$1/content" --content backup --output-format json
  exit $?
}

main() {
  local -a argv=()
  local re_line='^[A-Za-z0-9._ -]*$' re_vmid='^[0-9]{1,9}$' re_storage='^[A-Za-z][A-Za-z0-9._-]{0,63}$'
  # Whole-line check first (also rejects newlines, tabs and anything shell-like), then split on spaces without globbing.
  ((${#CMDLINE} <= 200)) || deny
  [[ $CMDLINE =~ $re_line ]] || deny
  read -r -a argv <<<"$CMDLINE"
  local n=${#argv[@]}
  case ${argv[0]:-inventory} in
    version)
      ((n == 1)) || deny
      echo "pve1-dash-helper $PROTOCOL"
      ;;
    inventory)
      # inventory [vmid] [quick]
      local want='' mode=''
      if ((n >= 2)) && [[ ${argv[n - 1]} == quick ]]; then
        mode=quick
        n=$((n - 1))
      fi
      if ((n == 2)) && [[ ${argv[1]} =~ $re_vmid ]]; then
        want=${argv[1]}
      elif ((n > 1)); then
        deny
      fi
      cmd_inventory "$want" "$mode"
      ;;
    sensors)
      ((n == 1)) || deny
      cmd_sensors
      ;;
    pkgupdates)
      ((n == 1)) || deny
      cmd_pkgupdates
      ;;
    hostinfo)
      ((n == 1)) || deny
      cmd_hostinfo
      ;;
    backups)
      # shellcheck disable=SC2015 # deny exits, so this is if-not-valid-then-deny
      ((n == 2)) && [[ ${argv[1]} =~ $re_storage ]] || deny
      cmd_backups "${argv[1]}"
      ;;
    *)
      deny
      ;;
  esac
}

main
